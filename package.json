{
  "name": "slagworks",
  "version": "0.1.0",
  "description": "Slagworks - a top-down factory automation game",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "serve": "node tools/serve.js",
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux AppImage tar.gz",
    "dist:linux-from-windows": "electron-builder --linux tar.gz"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "games.slagworks.app",
    "productName": "Slagworks",
    "directories": { "output": "dist" },
    "files": ["index.html", "style.css", "manifest.webmanifest", "icon.svg", "src/**", "desktop/**"],
    "win": { "target": ["portable", "nsis"] },
    "portable": { "artifactName": "Slagworks-${version}-portable.exe" },
    "nsis": { "artifactName": "Slagworks-${version}-setup.exe", "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Slagworks" },
    "linux": { "target": ["AppImage", "tar.gz"], "category": "Game" }
  }
}
